{
    "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
    "organizeImports": {
        "enabled": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedVariables": "warn"
            },
            "style": {
                "useConst": "error"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "files": {
        "ignore": [
            "node_modules",
            "dist",
            "assets/models/*.obj",
            "assets/audio/*.wav",
            "telemetry/*.json",
            "Lens_Studio_5.23.1_win_setup.exe"
        ]
    }
}
